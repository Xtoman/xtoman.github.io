---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'en' }}">
  <title>{{ site.author.name_en | default: site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name_en | xml_escape }}</name>
  </author>
  {% assign feed_projects = site.photoprojects | where_exp: "project", "project.published != false" %}
  {% for project in feed_projects %}
  {% assign project_folder = project.path | split: '/' | last | replace: '.md', '' %}
  {% assign project_cover = project.cover_thumb | default: project.cover_image %}
  <entry>
    <title>{{ project.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ site.baseurl }}{{ project.url }}" rel="alternate" type="text/html"/>
    <id>{{ site.url }}{{ site.baseurl }}{{ project.url }}</id>
    <published>{{ project.date | date_to_xmlschema }}</published>
    <updated>{{ project.date | date_to_xmlschema }}</updated>
    <category term="Photo projects"/>
    <summary type="html">{% if project_cover %}{{ '<p><img src="' | append: site.url | append: site.baseurl | append: '/assets/images/photoprojects/' | append: project_folder | append: '/' | append: project_cover | append: '" alt=""></p>' | xml_escape }}{% endif %}{{ project.description | xml_escape }}</summary>
  </entry>
  {% endfor %}
  {% for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ site.baseurl }}{{ post.url }}" rel="alternate" type="text/html"/>
    <id>{{ site.url }}{{ site.baseurl }}{{ post.url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.updated | default: post.date | date_to_xmlschema }}</updated>
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>
    {% endfor %}
    <summary>{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 300 | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
